<UserControl x:Class="BioAlgorithm.Core.Representatives.RepresentativeAlgorithmControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:BioAlgorithm.Core.Representatives"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <Grid x:Name="AlgGrid">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition />
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="4">
                <Button Content="Refresh"  Command="{Binding RefreshRepresentativeAlgorithmListCommand}"/>
            </StackPanel>
            <DataGrid Grid.Row="1" ItemsSource="{Binding RepresentativeAlgorithmGroups}" IsReadOnly="false" AutoGenerateColumns="False" Margin="1"
                           AlternationCount="2" RowBackground="#DDDDFF" AlternatingRowBackground="#CCCCEE"
                           SelectedItem="{Binding SelectedAlgorithm}"
                           SelectionMode="Single" SelectionUnit="FullRow" CanUserAddRows="False" CanUserDeleteRows="False">
                <DataGrid.Columns>
                    <DataGridTemplateColumn>
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <StackPanel>
                                <Button ToolTip="Move To Performance Tab And Apply Filter" Margin="1" Padding="1" 
                                    Command="{Binding Path=DataContext.ToFilterCommand, ElementName=AlgGrid}" CommandParameter="{Binding}" >
                                    <Image Width="25" Height="25" Source="/Pictures/document-export.png" />
                                </Button>
                             </StackPanel>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTemplateColumn>
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel>
                                    <Button ToolTip="Group Algorithm Performace By Dimension and Fill Filter" Margin="1" Padding="1" 
                                        Command="{Binding Path=DataContext.ToAsGroupFilterCommand, ElementName=AlgGrid}" CommandParameter="{Binding}" >
                                        <Image Width="25" Height="25" Source="/Pictures/eraser32.ico" />
                                    </Button>
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTemplateColumn>
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel>
                                    <Button ToolTip="Delete" Margin="1" Padding="1" 
                                        Command="{Binding Path=DataContext.DeleteAlgorithmCommand, ElementName=AlgGrid}" 
                                        CommandParameter="{Binding}">
                                        <Image Width="25" Height="25" Source="/Pictures/deleteTrackFromTheMap.png" />
                                    </Button>
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn Header="Algorithm" Binding="{Binding Algorithm}" MinWidth="200"></DataGridTextColumn>
                    <DataGridTextColumn Header="TotalCount" Binding="{Binding TotalCount}" MinWidth="150"></DataGridTextColumn>
                    <DataGridTextColumn Header="CountByDimension" Binding="{Binding CountByDimension}" MinWidth="150"></DataGridTextColumn>
                    <DataGridTextColumn Header="NumberOfIteration" Binding="{Binding NumberOfIteration}" MinWidth="150"></DataGridTextColumn>
                    <DataGridTextColumn Header="TotalDuration" Binding="{Binding TotalDuration}" MinWidth="150"></DataGridTextColumn>
                    <DataGridTextColumn Header="AverageDuration" Binding="{Binding AverageDuration}" MinWidth="150"></DataGridTextColumn>
                </DataGrid.Columns>

            </DataGrid>
            <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="4">
                <TextBlock Text="{Binding ExecutionState}"/>
            </StackPanel>
        </Grid>

    </Grid>
</UserControl>
