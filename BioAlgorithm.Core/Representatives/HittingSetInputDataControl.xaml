<UserControl x:Class="BioAlgorithm.Core.Representatives.HittingSetInputDataControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:BioAlgorithm.Core.Representatives"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="900">
    <UserControl.Resources>
        <local:TaskTypeToBrushConverter x:Key="taskTypeToBrushConverter"/>
    </UserControl.Resources>
    <Grid x:Name="InputDataGrid">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition />
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Grid Grid.Row="0"  Margin="3">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition/>
                </Grid.ColumnDefinitions>
                <Label Grid.Row="0" Grid.Column="2" Content="Top" Margin="2"/>
                <TextBox Grid.Row="0" Grid.Column="3" Text="{Binding HittingSetFilter.Top}" Margin="2" VerticalContentAlignment="Center"/>
                <StackPanel Grid.Column="4" Grid.ColumnSpan="6" Orientation="Horizontal">
                    <Button  Content="Refresh" Command="{Binding RefreshRepresentativeInputListCommand}"  Width="90" Margin="2"/>
                    <Button  Content="Run Task" Command="{Binding RunTaskCommand}" Width="90" Margin="2"/>
                    <Button  Content="Isomorphism" Command="{Binding RunIsomorphismTaskCommand}" Width="90" Margin="2"/>
                    <Button  Content="Isomorphism 2" Command="{Binding RunIsomorphismBipartTaskCommand}" Width="90" Margin="2"/>
                    <Button  Content="Type task" Command="{Binding RunDefineTypeTaskCommand}" Width="90" Margin="2"/>
                </StackPanel>
                <Label Grid.Column="0" Content="Sort" Margin="2"/>
                <ComboBox Grid.Column="1" Name="cbRPOrder"  ItemsSource="{Binding InputDataSortItems}"
                                  SelectedItem="{Binding SelectedInputDataSort}" IsEditable="true" IsReadOnly="true"/>
                <Label Grid.Row="1" Grid.Column="0" Content="Dimension" Margin="2"/>
                <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding HittingSetFilter.Dimension}" Margin="2" VerticalContentAlignment="Center"/>
                <Label Grid.Row="1" Grid.Column="2" Content="NumberOfSet" Margin="2"/>
                <TextBox Grid.Row="1" Grid.Column="3" Text="{Binding HittingSetFilter.NumberOfSet}" Margin="2" VerticalContentAlignment="Center"/>
                <Label Grid.Row="1" Grid.Column="4" Content="Step" Margin="2"/>
                <TextBox Grid.Row="1" Grid.Column="5" Text="{Binding HittingSetFilter.Step}" Margin="2" VerticalContentAlignment="Center"/>
                <Label Grid.Row="1" Grid.Column="6" Content="InputLen" Margin="2"/>
                <TextBox Grid.Row="1" Grid.Column="7" Text="{Binding HittingSetFilter.InputLen}" Margin="2" VerticalContentAlignment="Center"/>
                <Label Grid.Row="1" Grid.Column="8" Content="InputLenSort" Margin="2"/>
                <TextBox Grid.Row="1" Grid.Column="9" Text="{Binding HittingSetFilter.InputLenSort}" Margin="2" VerticalContentAlignment="Center"/>
                <StackPanel Grid.Row="2" Grid.Column="4" Grid.ColumnSpan="6" Orientation="Horizontal">
                    <ComboBox Name="cbTaskTypeFilter"  ItemsSource="{Binding TaskTypeFilterTypeSource}"
                  SelectedItem="{Binding HittingSetFilter.TaskTypeFilterType}" IsEditable="true" IsReadOnly="true"/>
                    <CheckBox Content="1" ToolTip="with element with only 1 set" IsChecked="{Binding TaskTypeFilter1}"  Width="50" Margin="2"/>
                    <CheckBox Content="2" ToolTip="elemуnt with element.set.count >= sets.count-1" IsChecked="{Binding TaskTypeFilter2}"  Width="50" Margin="2"/>
                    <CheckBox Content="4" ToolTip="set with only 1 element" IsChecked="{Binding TaskTypeFilter4}"  Width="50" Margin="2"/>
                    <CheckBox Content="8" ToolTip="there is set that contans all elements" IsChecked="{Binding TaskTypeFilter8}"  Width="50" Margin="2"/>
                    <CheckBox Content="16" ToolTip="other division on 2 separate part of sets" IsChecked="{Binding TaskTypeFilter16}"  Width="50" Margin="2"/>
                    <CheckBox Content="32" ToolTip="if set of sets that contain element e1 is subset of set of sets that contain element el2" IsChecked="{Binding TaskTypeFilter32}"  Width="50" Margin="2"/>
                </StackPanel>
            </Grid>
            <DataGrid Grid.Row="1" ItemsSource="{Binding InputDataList}" IsReadOnly="false" AutoGenerateColumns="False" Margin="1"
                           AlternationCount="2" RowBackground="#DDDDFF" AlternatingRowBackground="#CCCCEE"
                           SelectedItem="{Binding SelectedInputItem}"
                           SelectionMode="Single" SelectionUnit="FullRow" CanUserAddRows="False" CanUserDeleteRows="False">
                <DataGrid.Resources>
                    <Style TargetType="{x:Type DataGridCellsPresenter}">
                        <Setter Property="VerticalAlignment" Value="Center"/>
                        <Setter Property="VerticalContentAlignment" Value="Center"/>
                    </Style>
                </DataGrid.Resources>
                <DataGrid.Columns>
                    <DataGridTemplateColumn>
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel>
                                    <Button ToolTip="Move To Filter of Performance Tab And Apply Filter" Margin="1" Padding="1" 
                                        Command="{Binding Path=DataContext.ToFilterCommand, ElementName=InputDataGrid}" CommandParameter="{Binding}" >
                                        <Image Width="25" Height="25" Source="/Pictures/document-export.png" />
                                    </Button>
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTemplateColumn>
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel>
                                    <Button ToolTip="Move Graph" Margin="1" Padding="1" 
                                        Command="{Binding Path=DataContext.MakeGraphCommand, ElementName=InputDataGrid}" CommandParameter="{Binding}" >
                                        <Image Width="25" Height="25" Source="/Pictures/drawOnTheMap.png" />
                                    </Button>
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <!--<DataGridTemplateColumn>
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel>
                                    <Button ToolTip="Test isomorphism" Margin="1" Padding="1" 
                                            Command="{Binding Path=DataContext.TestIsomorphismCommand, ElementName=InputDataGrid}" 
                                            CommandParameter="{Binding}">
                                        <Image Width="25" Height="25" Source="/Pictures/task4.png" />
                                    </Button>
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTemplateColumn>
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel>
                                    <Button ToolTip="Test Bipartate graph isomorphism" Margin="1" Padding="1" 
                                            Command="{Binding Path=DataContext.TestIsomorphismBipartCommand, ElementName=InputDataGrid}" 
                                            CommandParameter="{Binding}">
                                        <Image Width="25" Height="25" Source="/Pictures/task4.png" />
                                    </Button>
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>-->
                    <DataGridTemplateColumn  MinWidth="20" Header="CountSet">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Label Content="{Binding NumberOfSet}" VerticalContentAlignment="Center"  VerticalAlignment="Stretch" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTemplateColumn  MinWidth="20" Header="Dim">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Label Content="{Binding Dimension}" VerticalContentAlignment="Center"  VerticalAlignment="Stretch" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTemplateColumn  MinWidth="80" Header="Step">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Label Content="{Binding Step}" VerticalContentAlignment="Center"  VerticalAlignment="Stretch" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTemplateColumn  MinWidth="100" Header="InputLen">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Label Content="{Binding InputLen}" VerticalContentAlignment="Center"  VerticalAlignment="Stretch" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTemplateColumn  MinWidth="100" Header="InputLenSort">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Label Content="{Binding InputLenSort}" VerticalContentAlignment="Center"  VerticalAlignment="Stretch" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTemplateColumn  MinWidth="40" Header="LenAvg">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Label Content="{Binding InputLenAvg}" VerticalContentAlignment="Center"  VerticalAlignment="Stretch" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTemplateColumn  MinWidth="200" Header="InputData">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Label Content="{Binding InputData}" VerticalContentAlignment="Center"  VerticalAlignment="Stretch" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTemplateColumn  MinWidth="200" Header="InputDataShort">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Label Content="{Binding InputDataShort}" VerticalContentAlignment="Center"  VerticalAlignment="Stretch"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTemplateColumn  MinWidth="50" Header="Task Type">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Label Content="{Binding TypeTask}" VerticalContentAlignment="Center" 
                                       Background="{ Binding TypeTask, Converter={StaticResource taskTypeToBrushConverter}}"
                                       VerticalAlignment="Stretch"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTemplateColumn  MinWidth="200" Header="Isomorphic">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Label Content="{Binding Isomorphic}" VerticalContentAlignment="Center"  VerticalAlignment="Stretch" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTemplateColumn  MinWidth="200" Header="IsomorphicBipart">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Label Content="{Binding IsomorphicBipart}" VerticalContentAlignment="Center"  VerticalAlignment="Stretch" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTemplateColumn  MinWidth="200" Header="IsomorphismResult">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Label Content="{Binding IsomorphismResult}" VerticalContentAlignment="Center"  VerticalAlignment="Stretch" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTemplateColumn  MinWidth="200" Header="IsomorphismBipartResult">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Label Content="{Binding IsomorphismBipartResult}" VerticalContentAlignment="Center"  VerticalAlignment="Stretch" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
            <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="4">
                <TextBlock Text="{Binding ExecutionState}"/>
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>
