<UserControl x:Class="BioAlgorithm.Core.Representatives.HittingSetInputDataControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:BioAlgorithm.Core.Representatives"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <Grid x:Name="InputDataGrid">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition />
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Grid Grid.Row="0"  Margin="3">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition/>
                </Grid.ColumnDefinitions>
                <Label Grid.Row="0" Grid.Column="2" Content="Top" Margin="2"/>
                <TextBox Grid.Row="0" Grid.Column="3" Text="{Binding HittingSetFilter.Top}" Margin="2" VerticalContentAlignment="Center"/>
                <Button Grid.Column="4" Content="Refresh" Command="{Binding RefreshRepresentativeInputListCommand}"/>
                <Label Grid.Column="0" Content="Sort" Margin="2"/>
                <ComboBox Grid.Column="1" Name="cbRPOrder"  ItemsSource="{Binding InputDataSortItems}"
                                  SelectedItem="{Binding SelectedInputDataSort}" IsEditable="true" IsReadOnly="true"/>
                <Label Grid.Row="1" Grid.Column="2" Content="Dimension" Margin="2"/>
                <TextBox Grid.Row="1" Grid.Column="3" Text="{Binding HittingSetFilter.Dimension}" Margin="2" VerticalContentAlignment="Center"/>
                <Label Grid.Row="1" Grid.Column="4" Content="NumberOfSet" Margin="2"/>
                <TextBox Grid.Row="1" Grid.Column="5" Text="{Binding HittingSetFilter.NumberOfSet}" Margin="2" VerticalContentAlignment="Center"/>
                <Label Grid.Row="1" Grid.Column="6" Content="Step" Margin="2"/>
                <TextBox Grid.Row="1" Grid.Column="7" Text="{Binding HittingSetFilter.Step}" Margin="2" VerticalContentAlignment="Center"/>
                <Label Grid.Row="2" Grid.Column="0" Content="InputLen" Margin="2"/>
                <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding HittingSetFilter.InputLen}" Margin="2" VerticalContentAlignment="Center"/>
                <Label Grid.Row="2" Grid.Column="2" Content="InputLenSort" Margin="2"/>
                <TextBox Grid.Row="2" Grid.Column="3" Text="{Binding HittingSetFilter.InputLenSort}" Margin="2" VerticalContentAlignment="Center"/>
            </Grid>
            <DataGrid Grid.Row="1" ItemsSource="{Binding InputDataList}" IsReadOnly="false" AutoGenerateColumns="False" Margin="1"
                           AlternationCount="2" RowBackground="#DDDDFF" AlternatingRowBackground="#CCCCEE"
                           SelectedItem="{Binding SelectedInputItem}"
                           SelectionMode="Single" SelectionUnit="FullRow" CanUserAddRows="False" CanUserDeleteRows="False">
                <DataGrid.Resources>
                    <Style TargetType="{x:Type DataGridCellsPresenter}">
                        <Setter Property="VerticalAlignment" Value="Center"/>
                        <Setter Property="VerticalContentAlignment" Value="Center"/>
                    </Style>
                </DataGrid.Resources>
                <DataGrid.Columns>
                    <DataGridTemplateColumn>
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel>
                                    <Button ToolTip="Move To Filter of Performance Tab And Apply Filter" Margin="1" Padding="1" 
                                        Command="{Binding Path=DataContext.ToFilterCommand, ElementName=InputDataGrid}" CommandParameter="{Binding}" >
                                        <Image Width="25" Height="25" Source="/Pictures/document-export.png" />
                                    </Button>
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTemplateColumn>
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel>
                                    <Button ToolTip="Move Graph" Margin="1" Padding="1" 
                                        Command="{Binding Path=DataContext.MakeGraphCommand, ElementName=InputDataGrid}" CommandParameter="{Binding}" >
                                        <Image Width="25" Height="25" Source="/Pictures/drawOnTheMap.png" />
                                    </Button>
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTemplateColumn>
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel>
                                    <Button ToolTip="Test isomorphism" Margin="1" Padding="1" 
                                            Command="{Binding Path=DataContext.TestIsomorphismCommand, ElementName=InputDataGrid}" 
                                            CommandParameter="{Binding}">
                                        <Image Width="25" Height="25" Source="/Pictures/task4.png" />
                                    </Button>
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn Header="NumberOfSet" Binding="{Binding NumberOfSet}" MinWidth="50"></DataGridTextColumn>
                    <DataGridTextColumn Header="Dimension" Binding="{Binding Dimension}" MinWidth="50"></DataGridTextColumn>
                    <DataGridTextColumn Header="Step" Binding="{Binding Step}" MinWidth="80"></DataGridTextColumn>
                    <DataGridTextColumn Header="InputLen" Binding="{Binding InputLen}" MinWidth="100"></DataGridTextColumn>
                    <DataGridTextColumn Header="InputLenSort" Binding="{Binding InputLenSort}" MinWidth="100"></DataGridTextColumn>
                    <DataGridTextColumn Header="InputLenAvg" Binding="{Binding InputLenAvg}" MinWidth="50"></DataGridTextColumn>
                    <DataGridTextColumn Header="InputData" Binding="{Binding InputData}" MinWidth="200"></DataGridTextColumn>
                    <DataGridTextColumn Header="InputDataShort" Binding="{Binding InputDataShort}" MinWidth="200"></DataGridTextColumn>
                </DataGrid.Columns>
            </DataGrid>
            <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="4">
                <TextBlock Text="{Binding ExecutionState}"/>
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>
