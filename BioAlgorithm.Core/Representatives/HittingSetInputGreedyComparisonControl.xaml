<UserControl x:Class="BioAlgorithm.Core.Representatives.HittingSetInputGreedyComparisonControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:BioAlgorithm.Core.Representatives"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <UserControl.Resources>
        <local:TaskTypeToBrushConverter x:Key="taskTypeToBrushConverter"/>
        <local:TaskTypeToForeColorConverter x:Key="taskTypeToForeColorConverter"/>
        <local:TaskTypeToBinaryConverter x:Key="taskTypeToBinaryConverter"/>
        <local:GreedyCompareToBrushConverter x:Key="greedyCompareToBrushConverter"/>
        <local:GreedyCompareToForeColorConverter x:Key="greedyCompareToForeColorConverter"/>
        <local:GreedyComparisonToBinaryConverter x:Key="greedyComparisonToBinaryConverter"/>
        <Style x:Key="cbTaskType">
            <Setter Property="Control.Margin" Value="2" />
            <Setter Property="Control.Width" Value="40" />
            <Setter Property="Control.VerticalAlignment" Value="Center" />
        </Style>
        <Style x:Key="cbGreedyComp">
            <Setter Property="Control.Margin" Value="2" />
            <Setter Property="Control.Width" Value="120" />
            <Setter Property="Control.VerticalAlignment" Value="Center" />
        </Style>
    </UserControl.Resources>
    <Grid x:Name="InputDataGrid">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition/>
        </Grid.RowDefinitions>
        <Label Grid.Row="0" FontWeight="Bold" HorizontalAlignment="Center" Margin="5">Hitting Set Input Geedy Algorithms Comparison</Label>
        <Grid Grid.Row="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition />
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Grid Grid.Row="0"  Margin="3">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition/>
                </Grid.ColumnDefinitions>
                <Label Grid.Row="0" Grid.Column="2" Content="Top" Margin="2"/>
                <TextBox Grid.Row="0" Grid.Column="3" Text="{Binding HittingSetFilter.Top}" Margin="2" 
                         VerticalContentAlignment="Center" Width="100"/>
                <StackPanel Grid.Column="4" Grid.ColumnSpan="6" Orientation="Horizontal">
                    <Button  ToolTip="Reload" Command="{Binding RefreshRepresentativeInputListCommand}" Margin="2">
                        <Image Width="25" Height="25" Source="/Pictures/reload.png" ToolTip="Reload"/>
                    </Button>
                    <Button  ToolTip="Define Type task" Command="{Binding RunDefineTypeTaskCommand}" Margin="2">
                        <Image Width="25" Height="25" Source="/Pictures/TaskType.ICO" ToolTip="Define Type task"/>
                    </Button>
                    <Button  ToolTip="Define GreedyComparison" Command="{Binding RunDefineGreedyComparisonCommand}" Margin="2">
                        <Image Width="25" Height="25" Source="/Pictures/input.png" ToolTip="Run Greedy Comparison"/>
                    </Button>
                </StackPanel>
                <Label Grid.Column="0" Content="Sort" Margin="2"/>
                <ComboBox Grid.Column="1" Name="cbRPOrder"  ItemsSource="{Binding InputDataSortItems}"
                                  SelectedItem="{Binding SelectedInputDataSort}" IsEditable="true" IsReadOnly="true"/>
                <Label Grid.Row="1" Grid.Column="0" Content="Dimension" Margin="2"/>
                <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding HittingSetFilter.Dimension}" Margin="2" VerticalContentAlignment="Center"/>
                <Label Grid.Row="1" Grid.Column="2" Content="NumberOfSet" Margin="2"/>
                <TextBox Grid.Row="1" Grid.Column="3" Text="{Binding HittingSetFilter.NumberOfSet}" Margin="2" VerticalContentAlignment="Center"
                          Width="100"/>
                <Label Grid.Row="1" Grid.Column="4" Content="MaxCount" Margin="2" />
                <TextBox Grid.Row="1" Grid.Column="5" Text="{Binding HittingSetFilter.MaxCount}" Margin="2" VerticalContentAlignment="Center"
                         Width="100"/>
                <StackPanel Grid.Row="1" Grid.Column="6" Grid.ColumnSpan="4" Orientation="Horizontal" VerticalAlignment="Center" Margin="10,0,0,0">
                    <Label Content="Input ask Type"  Width="150"/>
                    <CheckBox Content="1" ToolTip="with element with only 1 set" IsChecked="{Binding TaskTypeFilter1}"   Style="{StaticResource cbTaskType}"/>
                    <CheckBox Content="2" ToolTip="elemуnt with element.set.count >= sets.count-1" IsChecked="{Binding TaskTypeFilter2}"   Style="{StaticResource cbTaskType}"/>
                    <CheckBox Content="4" ToolTip="set with only 1 element" IsChecked="{Binding TaskTypeFilter4}"   Style="{StaticResource cbTaskType}"/>
                    <CheckBox Content="8" ToolTip="there is set that contans all elements" IsChecked="{Binding TaskTypeFilter8}"   Style="{StaticResource cbTaskType}"/>
                    <CheckBox Content="16" ToolTip="other division on 2 separate part of sets" IsChecked="{Binding TaskTypeFilter16}"   Style="{StaticResource cbTaskType}"/>
                    <CheckBox Content="32" ToolTip="if set of sets that contain element e1 is subset of set of sets that contain element el2" IsChecked="{Binding TaskTypeFilter32}"  Style="{StaticResource cbTaskType}"/>
                    <ComboBox Name="cbTaskTypeFilter"  ItemsSource="{Binding TaskTypeFilterTypeSource}"
                    SelectedItem="{Binding HittingSetFilter.TaskTypeFilterType}" IsEditable="true" IsReadOnly="true"/>
                </StackPanel>
                <Label Grid.Row="2" Grid.Column="2" Content="Pair Comparison" Margin="2"/>
                <ComboBox Grid.Row="2" Grid.Column="3" Name="cbPairComparison"  ItemsSource="{Binding PairComparisonItems}"
                                  SelectedItem="{Binding HittingSetFilter.PairComparison}" IsEditable="true" IsReadOnly="true"/>
                <Label Grid.Row="2" Grid.Column="4" Content="Worse Greedy" Margin="2"/>
                <ComboBox Grid.Row="2" Grid.Column="5" Name="cbSelectGreedy"  ItemsSource="{Binding SelectGreedyItems}"
                                  SelectedItem="{Binding HittingSetFilter.SelectedGreedy}" IsEditable="true" IsReadOnly="true"/>
                <StackPanel Grid.Row="2" Grid.Column="6" Grid.ColumnSpan="4" Orientation="Horizontal" VerticalAlignment="Center" Margin="10,0,0,0">
                    <Label Content="Differ From Optimap" Width="150"/>
                    <CheckBox Content="GreedySimple" ToolTip="GreedySimple worse than optimal value" IsChecked="{Binding GreedySimpleFilter}"  Style="{StaticResource cbGreedyComp}"/>
                    <CheckBox Content="GreedyRelation" ToolTip="GreedyRelation worse than optimal value" IsChecked="{Binding GreedyRelationFilter}"  Style="{StaticResource cbGreedyComp}"/>
                    <CheckBox Content="GreedyImprove" ToolTip="GreedyImprove worse than optimal value" IsChecked="{Binding GreedyImproveFilter}"  Style="{StaticResource cbGreedyComp}"/>
                    <CheckBox Content="GreedyImproveRD" ToolTip="GreedyImproveRD worse than optimal value" IsChecked="{Binding GreedyImproveRDFilter}"  Style="{StaticResource cbGreedyComp}"/>
                    <ComboBox Name="cbGreedyComparisonFilter"  ItemsSource="{Binding GreedyComparisonFilterTypeSource}"
                  SelectedItem="{Binding HittingSetFilter.GreedyComparisonFilterType}" IsEditable="true" IsReadOnly="true"/>
                </StackPanel>
            </Grid>
            <DataGrid Grid.Row="1" ItemsSource="{Binding InputDataList}" IsReadOnly="false" AutoGenerateColumns="False" Margin="1"
                           AlternationCount="2" RowBackground="#DDDDFF" AlternatingRowBackground="#CCCCEE"
                           SelectedItem="{Binding SelectedInputItem}"
                           SelectionMode="Single" SelectionUnit="FullRow" CanUserAddRows="False" CanUserDeleteRows="False">
                <DataGrid.Resources>
                    <Style TargetType="{x:Type DataGridCellsPresenter}">
                        <Setter Property="VerticalAlignment" Value="Center"/>
                        <Setter Property="VerticalContentAlignment" Value="Center"/>
                    </Style>
                </DataGrid.Resources>
                <DataGrid.Columns>
                    <DataGridTemplateColumn>
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel>
                                    <Button ToolTip="Move To Filter of Performance Tab And Apply Filter" Margin="1" Padding="1" 
                                        Command="{Binding Path=DataContext.ToFilterCommand, ElementName=InputDataGrid}" CommandParameter="{Binding}" >
                                        <Image Width="25" Height="25" Source="/Pictures/hs-performance-result.png" />
                                    </Button>
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTemplateColumn>
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel>
                                    <Button ToolTip="Move Graph" Margin="1" Padding="1" 
                                        Command="{Binding Path=DataContext.MakeGraphCommand, ElementName=InputDataGrid}" CommandParameter="{Binding}" >
                                        <Image Width="25" Height="25" Source="/Pictures/hs-bipartite-graph.png" />
                                    </Button>
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTemplateColumn  MinWidth="20" Header="CountSet">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Label Content="{Binding NumberOfSet}" VerticalContentAlignment="Center"  VerticalAlignment="Stretch" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTemplateColumn  MinWidth="20" Header="Dim">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Label Content="{Binding Dimension}" VerticalContentAlignment="Center"  VerticalAlignment="Stretch" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTemplateColumn  MinWidth="80" Header="MaxCount">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Label Content="{Binding MaxCount}" VerticalContentAlignment="Center"  VerticalAlignment="Stretch" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTemplateColumn  MinWidth="200" Header="InputData">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Label Content="{Binding InputData}" VerticalContentAlignment="Center"  VerticalAlignment="Stretch" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTemplateColumn  MinWidth="50" Header="Task Type">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Label Content="{Binding TypeTask}" VerticalContentAlignment="Center" 
                                       Background="{ Binding TypeTask, Converter={StaticResource taskTypeToBrushConverter}}"
                                       Foreground="{ Binding TypeTask, Converter={StaticResource taskTypeToForeColorConverter}}"
                                       VerticalAlignment="Stretch"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTemplateColumn  MinWidth="50" Header="Type as Binary">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Label Content="{ Binding TypeTask, Converter={StaticResource taskTypeToBinaryConverter}}" VerticalContentAlignment="Center" 
                                       VerticalAlignment="Stretch"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTemplateColumn  MinWidth="50" Header="GreedyComparison">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Label Content="{Binding GreedyComparison}" VerticalContentAlignment="Center" 
                                       VerticalAlignment="Stretch"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTemplateColumn  MinWidth="50" Header="GreedyComparisonClac">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Label Content="{Binding GreedyComparisonCalc}" VerticalContentAlignment="Center" 
                                       VerticalAlignment="Stretch"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTemplateColumn  MinWidth="50" Header="GreedyComp as Bin">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Label Content="{ Binding GreedyComparison, Converter={StaticResource greedyComparisonToBinaryConverter}}" VerticalContentAlignment="Center" 
                                       Background="{ Binding GreedyComparison, Converter={StaticResource greedyCompareToBrushConverter}}"
                                       Foreground="{ Binding GreedyComparison, Converter={StaticResource greedyCompareToForeColorConverter}}"
                                       VerticalAlignment="Stretch"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTemplateColumn  MinWidth="100" Header="BestValue">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Label Content="{Binding BestValue}" VerticalContentAlignment="Center"  VerticalAlignment="Stretch" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTemplateColumn  MinWidth="100" Header="BestValueSimple">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Label Content="{Binding BestValueSimple}" VerticalContentAlignment="Center"  VerticalAlignment="Stretch" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTemplateColumn  MinWidth="100" Header="BestValueRelation">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Label Content="{Binding BestValueRelation}" VerticalContentAlignment="Center"  VerticalAlignment="Stretch" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTemplateColumn  MinWidth="100" Header="BestValueImprove">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Label Content="{Binding BestValueImprove}" VerticalContentAlignment="Center"  VerticalAlignment="Stretch" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTemplateColumn  MinWidth="100" Header="BestValueImproveRD">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Label Content="{Binding BestValueImproveRD}" VerticalContentAlignment="Center"  VerticalAlignment="Stretch" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
            <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="4">
                <TextBlock Text="{Binding ExecutionState}" VerticalAlignment="Center"/>
                <Label Content="Total number of rows" Margin="10,0,5,0"/>
                <TextBlock Text="{Binding TotalNumberRows}" VerticalAlignment="Center"/>
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>
